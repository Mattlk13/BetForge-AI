# Browser-safe configuration
VITE_BETFORGE_API_BASE=/api

# Server-side provider keys: configure in Cloudflare, never VITE_ prefixed.
ODDS_API_KEY=
SPORTSGAMEODDS_KEY=

# Optional provider selector: mock | odds-api | sportsgameodds
ODDS_PROVIDER=mock

# Comma-separated HTTPS origins for API CORS. Empty means same-site deployment.
BETFORGE_ALLOWED_ORIGINS=

# Future Cloudflare Access / OIDC configuration for protected endpoints.
BETFORGE_AUTH_ISSUER=
BETFORGE_AUTH_AUDIENCE=
BETFORGE_AUTH_JWKS_URL=
